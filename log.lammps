LAMMPS (20 Nov 2019)
####
# Combined 2D equilibration + production run
###

units lj
#dimensionless

dimension 2
atom_style atomic
#only stores values for type position velocity

#periodic boundary conditions
boundary p p p

###
# Neighbors
###
#only hold a list of near neighbour interactions not all 1xN interactions for each particle
neighbor 1.9 bin
neigh_modify every 1 delay 1 check yes

###
# Read initial configuration (generated with Python or Fortran script)
###
read_data lammps_input_pd
  orthogonal box = (-15.2259 -15.2259 -0.5) to (15.2259 15.2259 0.5)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  1000 atoms
  reading velocities ...
  1000 velocities
  read_data CPU = 0.001654 secs

reset_timestep 0

###
# Define groups (all atoms)
###
#group all type *

###
# Dumps
###
dump   id all atom 10000 dump.LJ

###################################################################
# EQUILIBRATION STAGE
# Using "soft" potential to relax overlaps
###################################################################

pair_style soft 1.12246152962189

include pair.polydisperse.equilibration
pair_coeff 1 1 100.000000 0.460209
pair_coeff 1 2 100.000000 0.471434
pair_coeff 1 3 100.000000 0.482659
